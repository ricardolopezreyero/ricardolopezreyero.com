{
  // ricardolopezreyero.com · sitio personal (React) servido desde Cloudflare · Ricardo López Reyero (RLR)
  // El sitio compilado (./build) lo entrega Cloudflare directo. El Worker solo atiende
  // /api/* (contador de visitas, D1) y /pesados/* (audios y archivos de más de 25 MB, R2).
  "name": "ricardolopezreyero-com",
  "account_id": "93695b987a7460c681c06ca4df901ef4",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/pesados/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ricardolopezreyero-visitas",
      "database_id": "fc0e727a-952a-45c1-ba95-9ad9393cacd6"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIOS", "bucket_name": "ricardolopezreyero-medios" }],
  // El dominio entra por rutas sobre los registros DNS con proxy (nube naranja) de la zona.
  // Mientras la ruta cubra /*, el Worker responde todo y la IP del registro A nunca se consulta.
  "routes": [
    { "pattern": "ricardolopezreyero.com/*", "zone_name": "ricardolopezreyero.com" },
    { "pattern": "www.ricardolopezreyero.com/*", "zone_name": "ricardolopezreyero.com" }
  ],
  "workers_dev": true,
  "observability": { "enabled": true }
}
