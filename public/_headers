# ricardolopezreyero.com · encabezados de Cloudflare · RLR
# Los archivos de /static llevan huella en el nombre: se pueden guardar un año.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# El service worker y el manifiesto de archivos siempre se piden frescos.
/sw.js
  Cache-Control: no-cache

/asset-manifest.json
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
